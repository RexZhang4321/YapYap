{
  "name": "yapyap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --conditions=yapyap-windows --experimental-transform-types --test scripts/application-model.test.mjs scripts/audio-capture-worklet.test.mjs scripts/native-capture.test.mjs scripts/transcription-session.test.mjs scripts/live-transcription.test.mjs scripts/api-key-privacy.test.mjs scripts/overlay.test.mjs scripts/recovery-audit.test.mjs scripts/provisional-recovery.test.mjs scripts/ux-behavior.test.mjs scripts/actionable-recovery.test.mjs scripts/ui-store.test.mjs scripts/vite-cache.test.mjs scripts/platform.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:macos": "tauri dev --config src-tauri/tauri.macos.conf.json",
    "build:macos": "tauri build --config src-tauri/tauri.macos.conf.json --bundles app,dmg",
    "install:macos": "node scripts/install-macos.mjs",
    "test:ui": "node scripts/run-ui-tests.mjs",
    "test:group3": "node scripts/group3-regression.mjs",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "format:ui": "prettier --write src/ui src/main.tsx src/overlay.tsx"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "imports": {
    "#platform": {
      "yapyap-windows": "./src/platform/platform.windows.ts",
      "yapyap-macos": "./src/platform/platform.macos.ts",
      "default": "./src/platform/platform.unsupported.ts"
    }
  }
}
